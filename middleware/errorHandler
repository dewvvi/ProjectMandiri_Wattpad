
module.exports = (err, req, res, next) => {
  let statusCode = err.statusCode || 500;
  let message =
    err.message || "Terjadi kesalahan pada server";

  // ID MongoDB tidak valid
  if (err.name === "CastError") {
    statusCode = 400;
    message = "Format ID cerita tidak valid";
  }

  // Validasi schema Mongoose
  if (err.name === "ValidationError") {
    statusCode = 400;
    message = err.message;
  }

  // Data unik duplikat, jika ada unique index
  if (err.code === 11000) {
    statusCode = 409;
    message = "Data dengan nilai unik tersebut sudah ada";
  }

  res.status(statusCode).json({
    success: false,
    message
  });
};
